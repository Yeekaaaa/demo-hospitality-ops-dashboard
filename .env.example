# 复制为 .env.local 后按需填写。勿提交 .env.local 到 Git。
# Copy to .env.local — never commit secrets or production URLs.

# --- Supabase（可选 / optional）---
# 不配置时应用使用本地演示数据。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- 演示标识（可选预留 / optional demo flags）---
# 公开仓库请使用占位值；不要使用真实 project ref 或 anon key。
NEXT_PUBLIC_DEMO_MODE=1
NEXT_PUBLIC_DEMO_USER_NAME=演示用户

# 禁止放入本文件 / DO NOT put in this file:
# - SUPABASE_SERVICE_ROLE_KEY
# - database password
# - real store UUID lists
# - real company or store names
